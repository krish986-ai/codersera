# Server-side Gemini API (if used)
GEMINI_API_KEY=

# Firebase Admin configuration (Vercel server-side only; never use VITE_ for these)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase Web Auth configuration only (public identifiers, not service-account credentials)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# SMTP for OTP emails (use Gmail App Password or any SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password

# Local admin authentication
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
AUTH_PORT=3001
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
